# Djangoコア設定
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_SECURE_SSL_REDIRECT=True
# CaddyなどのリバースプロキシでTLS終端する場合はTrue (docker-compose.prod.yml は自動でTrue)
DJANGO_BEHIND_PROXY=False
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
# docker-compose.prod.yml の Caddy が証明書を取得するドメイン
SITE_DOMAIN=example.com
ACME_EMAIL=admin@example.com
# Caddy を使わずに Django から HSTS を返す場合のみ設定する (例: 31536000 = 1年)。
# docker-compose.prod.yml の構成では Caddyfile が HSTS を付けるので 0 のままでよい。
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_LOG_LEVEL=INFO

# データベース (PostgreSQL)
DB_NAME=portfolio_db
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# Apple Music / MusicKit
APPLE_MUSIC_DEVELOPER_TOKEN=

# Mapbox (WanderLens の地図)。https://account.mapbox.com/ の公開トークン (pk.)
# URL 制限は付けない (Safari が Referer を送らず 403 になるため)。代わりに使用量の通知を設定しておく
MAPBOX_ACCESS_TOKEN=
# 任意: Mapbox Studio で作ったスタイルに差し替える (mapbox://styles/<user>/<id>)
# MAPBOX_STYLE=mapbox://styles/mapbox/dark-v11
# MAPBOX_SATELLITE_STYLE=mapbox://styles/mapbox/satellite-streets-v12
# MAPBOX_EDITOR_STYLE=mapbox://styles/mapbox/streets-v12

# Azure AI Translator (Blogs の記事を公開時に英訳する)。Azure ポータルで Translator を価格レベル F0 (無料) で作り、
# 「キーとエンドポイント」のキーとリージョン (例: japaneast) を入れる。空なら英訳しない
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=

# Sign in with Apple (Apple Developer Console で取得)
# Services ID (例: com.example.webapp)
APPLE_CLIENT_ID=
# Apple Developer Team ID
APPLE_TEAM_ID=
# Sign in with Apple 用 Key の ID
APPLE_KEY_ID=
# .p8 ファイルの秘密鍵の内容（改行は \n に置換して1行にする）
APPLE_SECRET_KEY=

# メール通知 (お問い合わせフォーム)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=webmaster@example.com
CONTACT_NOTIFY_EMAIL=admin@example.com

# アクセス解析の位置情報データベース (docs/deploy.md の 9 章)。geoip コンテナが自動で取得・更新する
# dbip: DB-IP IP to City Lite (登録不要) / maxmind: GeoLite2 City (下の 2 つが必要)
GEOIP_SOURCE=dbip
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
