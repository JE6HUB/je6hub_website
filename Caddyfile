{
	email {$ACME_EMAIL}

	# Cloudflare のプロキシ(オレンジの雲)経由のとき、接続元は Cloudflare の IP になる。
	# Cloudflare からの接続に限り CF-Connecting-IP を本当の訪問者 IP として信頼する。
	# 一覧: https://www.cloudflare.com/ips/ (2026-09 時点)
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$SITE_DOMAIN} {
	encode zstd gzip

	# 送信サイズの上限 (Lounge の動画 200MB / WanderLens の写真 10 枚が最大)。
	# 巨大なファイルを送りつけてディスクを埋める攻撃を、Django に届く前に止める
	request_body {
		max_size 260MB
	}

	# ユーザーアップロード(写真)は DEBUG=False では Django が配信しないため Caddy が直接返す
	# Lounge の添付は URL を知っていても直接は開けない。
	# Django (community.views.message_media) が閲覧権限を確認してから、下の handle_response で配信する
	handle /media/community/* {
		respond 404
	}

	handle_path /media/* {
		# core.middleware.MediaSvgSecurityMiddleware と同じヘッダー。
		# Caddy が直接配信すると Django を通らないため、ここでも付ける。
		header X-Content-Type-Options nosniff
		@svg path_regexp svg (?i)\.svg$
		@notsvg not path_regexp (?i)\.svg$
		header @svg Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src data:; sandbox"
		# 画像・動画以外 (過去にアップロードされた HTML など) が開かれてもスクリプトを動かさない
		header @notsvg Content-Security-Policy "default-src 'none'; img-src 'self' data:; media-src 'self'; style-src 'unsafe-inline'; sandbox"
		root * /srv/media
		file_server
	}

	handle {
		# Django のレート制限・送信元IP記録は X-Forwarded-For の先頭を使うため、
		# 訪問者 IP 1つだけに置き換えて偽装を防ぐ
		reverse_proxy web:8000 {
			header_up X-Forwarded-For {client_ip}

			# Django が権限を確認して X-Accel-Redirect を返したときだけ、そのファイルを送る
			# (Range 要求にも対応するので、動画のシークができる)
			@accel header X-Accel-Redirect *
			handle_response @accel {
				root * /srv/media
				rewrite * {rp.header.X-Accel-Redirect}
				method * GET
				header X-Content-Type-Options nosniff
				header Cache-Control "private, max-age=3600"
				header Content-Security-Policy "default-src 'none'; img-src 'self' data:; media-src 'self'; style-src 'unsafe-inline'; sandbox"
				file_server
			}
		}
	}
}
